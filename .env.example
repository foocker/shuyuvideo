# Copy to tools/shuyuvideo/.env. Existing environment variables take precedence.
# Role: default | doubao-magnetic | doubao-young | minimax-gentle | minimax-elite
#       doubao-custom | minimax-custom
# default preserves the narrator configured in each film's manuscript.
SHUYU_VOICE_ROLE=default

# Doubao TTS 2.0: magnetic narrator / sunny youth (official system voices).
DOUBAO_API_KEY=
DOUBAO_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
# Legacy console auth, only used when DOUBAO_API_KEY is blank:
DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
# Used by doubao-custom. For a clone use its voice ID and matching ICL 2.0 resource.
DOUBAO_VOICE_ID=
# Optional model override for ICL 2.0 only; leave blank for system voices.
DOUBAO_MODEL=

# MiniMax. For a global account use https://api.minimax.io/v1/t2a_v2
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_TTS_URL=https://api.minimax.cn/v1/t2a_v2
# Used by minimax-custom: a provider-issued system/custom/cloned voice ID.
MINIMAX_VOICE_ID=
